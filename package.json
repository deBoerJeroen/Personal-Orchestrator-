{
  "name": "nu",
  "version": "0.1.0",
  "private": true,
  "description": "Persoonlijke uitvoeringsassistent op basis van GTD, Atomic Habits en Let Them",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:migrate && pnpm seed && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "setup": "pnpm db:migrate && pnpm seed"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "better-auth": "^1.6.25",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
