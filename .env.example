# Neon Postgres, regio Frankfurt (EU). Gebruik de POOLED connection string:
# die met "-pooler" erin. Zie README.
DATABASE_URL="postgresql://gebruiker:wachtwoord@ep-iets-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Willekeurige geheime tekst van minstens 32 tekens. Zelf verzinnen mag.
BETTER_AUTH_SECRET=""
# Lokaal http://localhost:3000 — online https://jouw-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Jouw account. Hiermee maakt `pnpm seed` de enige gebruiker aan.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
SEED_USER_NAME=""

# Alleen tijdelijk gebruiken om een vergeten wachtwoord te resetten. Zie README.
# SEED_RESET_PASSWORD="true"
